      "name": "01 - Produtos",
      "description": "Endpoints para catálogo e gestão de produtos e semijoias",
      "item": [
        {
          "name": "Consultas (Público)",
          "description": "Rotas públicas consumidas pela vitrine e páginas de produto",
          "item": [
            {
              "name": "Listar Produtos Ativos",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code é 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Retorna lista de produtos com categorias vinculadas\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"data\");",
                      "    pm.expect(jsonData.data).to.be.an(\"array\");",
                      "    if (jsonData.data.length > 0) {",
                      "        pm.collectionVariables.set(\"product_id\", jsonData.data[0].id);",
                      "        console.log(\"ID do produto capturado:\", jsonData.data[0].id);",
                      "    }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/products",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "products"
                  ]
                },
                "description": "Retorna a listagem de produtos ativos com categoria associada, ordenados por nome."
              }
            },
            {
              "name": "Buscar Produto por ID",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code é 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Produto encontrado corresponde ao ID pesquisado\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"data\");",
                      "    pm.expect(jsonData.data.id).to.eql(pm.variables.get(\"product_id\"));",
                      "});"
