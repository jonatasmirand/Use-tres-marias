    {
      "name": "03 - Autenticação & Usuários",
      "description": "Rotas de autenticação integradas diretamente ao Supabase Auth",
      "item": [
        {
          "name": "Sessão & Tokens",
          "description": "Login com email/senha, consulta de usuário e encerramento de sessão",
          "item": [
            {
              "name": "Login Admin (E-mail e Senha)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code é 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "if (jsonData.access_token) {",
                      "    pm.environment.set(\"auth_token\", jsonData.access_token);",
                      "    pm.collectionVariables.set(\"auth_token\", jsonData.access_token);",
                      "    console.log(\"Token JWT gravado em {{auth_token}}!\");",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{supabase_anon_key}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@usetresmarias.com.br\",\n  \"password\": \"senha-do-admin-aqui\"\n}"
                },
                "url": {
                  "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
                  "host": [
                    "{{supabase_url}}"
                  ],
                  "path": [
                    "auth",
                    "v1",
                    "token"
                  ],
                  "query": [
                    {
                      "key": "grant_type",
                      "value": "password"
                    }
                  ]
                },
                "description": "Autentica usuário administrativo e preenche automaticamente o token JWT na variável {{auth_token}} para testes subsequentes."
              }
            },
            {
              "name": "Obter Dados do Usuário Logado",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code é 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Usuário possui id e email\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"id\");",
                      "    pm.expect(jsonData).to.have.property(\"email\");",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
